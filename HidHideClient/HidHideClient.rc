    CONTROL         "Enabled",IDC_PROFILE_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,533,73,57,15
    LTEXT           "P&riority",IDC_PROFILE_PRIORITY_LABEL,596,74,36,10
