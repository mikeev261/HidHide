    EDITTEXT        IDC_PROFILE_PATH,194,101,398,23,ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON      "Open JSON",IDC_PROFILE_OPEN_JSON,598,97,62,23,WS_TABSTOP
    PUSHBUTTON      "Change app...",IDC_PROFILE_CHANGE_APP,665,97,112,23,WS_TABSTOP
    LTEXT           "&Device visibility",IDC_PROFILE_DEVICES_LABEL,194,132,100,12
    LTEXT           "Hidden means hidden globally except from Allowed apps. Visible means not hidden by HidHide.",IDC_STATIC,194,146,530,12
    CONTROL         "",IDC_PROFILE_DEVICES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,194,163,583,230,WS_EX_CLIENTEDGE
